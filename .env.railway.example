# Reference/template for the Railway service Variables. Railway does not load
# this file automatically; set these values in the Railway service settings.

STRAVA_CLIENT_ID=your_railway_strava_client_id
STRAVA_CLIENT_SECRET=your_railway_strava_client_secret

# Public HTTPS URL of the Railway service, with no trailing slash.
APP_BASE_URL=https://your-app.up.railway.app

# Generate independent, stable random values for the Railway deployment.
SESSION_SECRET=replace_with_a_long_random_secret
STRAVA_WEBHOOK_VERIFY_TOKEN=replace_with_a_separate_random_secret

# Railway injects PORT. Do not set a fixed PORT for the service.
