# Copy this file to `.env` and fill in your Strava API app credentials.
# Create an API application at: https://www.strava.com/settings/api
# Authorization Callback Domain should be: localhost

STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# Public base URL of this app (used for OAuth redirect). For local dev keep as-is.
APP_BASE_URL=http://localhost:3000

# Random string used to sign session cookies
SESSION_SECRET=change_me_to_a_long_random_string

# Random string Strava sends back when verifying the webhook callback
STRAVA_WEBHOOK_VERIFY_TOKEN=change_me_to_another_long_random_string

# Port to run on
PORT=3000

# Optional: Wahoo Cloud API app credentials, used to fetch original FIT files
# from Wahoo. Register an app at https://developers.wahooligan.com and set its
# redirect URI to {APP_BASE_URL}/auth/wahoo/callback.
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=

# Optional: Garmin login relay (see "Garmin login relay" in the README).
# On the hosted app, set both. On the relay machine, set GARMIN_RELAY_SECRET
# (and optionally GARMIN_RELAY_PORT / GARMIN_RELAY_HOST).
GARMIN_RELAY_URL=
GARMIN_RELAY_SECRET=
